rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. DEFAULT DENY CATCH-ALL
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. PRIMITIVE GLOBAL HELPERS
    function isSignedIn() {
      return request.auth != null && accountActive() && bridgeSessionValid() && (!exists(/databases/$(database)/documents/account_deletions/$(request.auth.uid)) || get(/databases/$(database)/documents/account_deletions/$(request.auth.uid)).data.status == 'requested');
    }
    function accountActive() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspended', false) == false &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) == false);
    }
    function bridgeSessionValid() {
      let account = /databases/$(database)/documents/users/$(request.auth.uid);
      return request.auth.token.keys().hasAny(['allgoSession'])
        ? (exists(/databases/$(database)/documents/bridge_sessions/$(request.auth.token.allgoSession)) &&
        get(/databases/$(database)/documents/bridge_sessions/$(request.auth.token.allgoSession)).data.uid == request.auth.uid &&
        get(/databases/$(database)/documents/bridge_sessions/$(request.auth.token.allgoSession)).data.expiresAt > request.time)
        : (!exists(account) || get(account).data.get('accountAuthority', '') != 'neon');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDriverOwner(driverId) {
      return isSignedIn() && (driverId == request.auth.uid || driverId == request.auth.uid + '_drv');
    }

    function driverEligibilityNotExpired(driverId) {
      let eligibility = /databases/$(database)/documents/driver_eligibility/$(driverId);
      return !exists(eligibility) || get(eligibility).data.get('status', '') != 'expired';
    }

    function isAssignedVerifiedDriver(data) {
      return isDriverOwner(data.get('driverId', ''))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver'
        && get(/databases/$(database)/documents/driver_profiles/$(request.auth.uid)).data.status == 'verified';
    }

    function isVerifiedOnlineDriver() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver'
        && get(/databases/$(database)/documents/driver_profiles/$(request.auth.uid)).data.status == 'verified'
        && get(/databases/$(database)/documents/driver_profiles/$(request.auth.uid)).data.online == true
        && driverEligibilityNotExpired(request.auth.uid);
    }

    function canReceiveBooking(data) {
      let driver = get(/databases/$(database)/documents/driver_profiles/$(request.auth.uid)).data;
      return isVerifiedOnlineDriver() && data.driverId == null && data.serviceType in driver.get('supportedServices', [])
        && ((data.serviceType in ['food', 'grocery'] && data.status == 'ready') || (!(data.serviceType in ['food', 'grocery']) && data.status == 'pending'))
        && (data.serviceType != 'ride' || data.details.vehicleType == driver.vehicleType);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      let account = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isSignedIn() && request.auth.token.get('admin', false) == true
        && account.role == 'admin' && account.get('suspended', false) == false && account.get('disabled', false) == false;
    }

    function incoming() {
      return request.resource.data;
    }

    function isMerchantFor(data) {
      let account = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isSignedIn() && account.role == 'merchant'
        && account.get('merchantId', '') != ''
        && data.get('merchantId', '') == account.get('merchantId', '')
        && ((account.get('merchantType', '') == 'restaurant' && data.serviceType == 'food') || (account.get('merchantType', '') == 'grocery' && data.serviceType == 'grocery'));
    }

    function existing() {
      return resource.data;
    }

    function canAccessBooking(bookingId) {
      let booking = get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      return isSignedIn() && (
        booking.customerId == request.auth.uid ||
        isAssignedVerifiedDriver(booking) ||
        isMerchantFor(booking) ||
        isAdmin()
      );
    }

    function canAccessDeliveryDetails(bookingId) {
      let booking = get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      return isSignedIn() && (
        booking.customerId == request.auth.uid || isAssignedVerifiedDriver(booking) || isAdmin()
      );
    }

    function isMerchantForLeg(data) {
      let account = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isSignedIn() && account.role == 'merchant'
        && account.get('merchantId', '') != ''
        && data.get('merchantId', '') == account.get('merchantId', '')
        && ((account.get('merchantType', '') == 'restaurant' && data.type == 'food') || (account.get('merchantType', '') == 'grocery' && data.type == 'grocery'));
    }

    function canReadLeg(bundleId, legData) {
      let bundle = get(/databases/$(database)/documents/bundles/$(bundleId)).data;
      return isSignedIn() && (
        bundle.customerId == request.auth.uid ||
        isAssignedVerifiedDriver(legData) ||
        isMerchantForLeg(legData) ||
        isAdmin()
      );
    }

    function canReadBundleChat(bundleId, legData) {
      let account = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let bundle = get(/databases/$(database)/documents/bundles/$(bundleId)).data;
      let active = legData.status in ['pending', 'accepted', 'preparing', 'ready', 'transit', 'at_merchant_stop'];
      return isSignedIn() && (
        (account.role == 'customer' && bundle.customerId == request.auth.uid) || isAdmin() ||
        (active && isMerchantForLeg(legData)) ||
        (active && account.role == 'driver' && isDriverOwner(legData.get('driverId', '')) &&
          get(/databases/$(database)/documents/driver_profiles/$(request.auth.uid)).data.status == 'verified')
      );
    }

    // 3. VALIDATION HELPERS BY COLLECTION

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role']) 
        && data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'role', 'createdAt', 'walletBalance', 'photoURL', 'defaultAddressId', 'defaultAddress', 'preferences', 'favorites', 'merchantId', 'merchantType', 'accountAuthority', 'neonAccountId'])
        && (!data.keys().hasAny(['favorites']) || (data.favorites is list && data.favorites.size() <= 200))
        && data.uid == request.auth.uid
        && data.name is string && data.name.size() <= 100
        && data.email is string && data.email.size() <= 100
        && (data.role == 'customer' || data.role == 'driver' || data.role == 'merchant' || data.role == 'admin')
        && (!data.keys().hasAny(['phone']) || (data.phone is string && data.phone.size() <= 20))
        && (!data.keys().hasAny(['walletBalance']) || (data.walletBalance is int || data.walletBalance is float))
        && (!data.keys().hasAny(['defaultAddressId']) || (data.defaultAddressId is string && data.defaultAddressId.size() <= 128))
        && (!data.keys().hasAny(['defaultAddress']) || (data.defaultAddress is string && data.defaultAddress.size() <= 300))
        && (!data.keys().hasAny(['preferences']) || (
          data.preferences is map
          && data.preferences.keys().hasAll(['orderUpdates', 'promotions', 'language'])
          && data.preferences.keys().hasOnly(['orderUpdates', 'promotions', 'language'])
          && data.preferences.orderUpdates is bool
          && data.preferences.promotions is bool
          && (data.preferences.language == 'en' || data.preferences.language == 'ta')
        ));
    }

    function isValidDriverProfile(data, driverId) {
      return data.keys().hasAll(['driverId', 'vehicleType', 'vehicleNo', 'licenseNo', 'status', 'online'])
        && data.keys().hasOnly(['driverId', 'vehicleType', 'vehicleNo', 'licenseNo', 'status', 'online', 'currentLat', 'currentLng', 'todayEarnings', 'completedJobs', 'activeBookingId', 'earningsDate', 'rejectedBookingIds', 'availableEarningsCents', 'reservedEarningsCents', 'supportedServices', 'locationUpdatedAt', 'locationAccuracyMeters', 'transportCapabilities', 'locationConsent', 'locationConsentAt'])
        && data.driverId == driverId
        && (data.vehicleType == 'bike' || data.vehicleType == 'auto' || data.vehicleType == 'car' || data.vehicleType == 'suv')
        && data.vehicleNo is string && data.vehicleNo.size() <= 30
        && data.licenseNo is string && data.licenseNo.size() <= 50
        && (data.status == 'pending' || data.status == 'verified' || data.status == 'rejected')
        && data.online is bool
        && (!data.keys().hasAny(['currentLat']) || (data.currentLat is int || data.currentLat is float))
        && (!data.keys().hasAny(['currentLng']) || (data.currentLng is int || data.currentLng is float))
        && (!data.keys().hasAny(['todayEarnings']) || (data.todayEarnings is int || data.todayEarnings is float))
        && (!data.keys().hasAny(['completedJobs']) || (data.completedJobs is int || data.completedJobs is float));
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['bookingId', 'customerId', 'customerName', 'serviceType', 'status', 'price'])
        && data.keys().hasOnly(['bookingId', 'customerId', 'customerName', 'serviceType', 'status', 'price', 'createdAt', 'updatedAt', 'pickupAddress', 'dropAddress', 'driverId', 'driverName', 'otp', 'paymentStatus', 'paymentMethod', 'paymentOrderId', 'paymentId', 'details', 'driverPayout'])
        && data.bookingId is string && data.bookingId.size() <= 100
        && data.customerId == request.auth.uid
        && data.customerName is string && data.customerName.size() <= 100
        && (data.serviceType == 'food' || data.serviceType == 'grocery' || data.serviceType == 'ride' || data.serviceType == 'parcel' || data.serviceType == 'takeover' || data.serviceType == 'transport')
        && (data.status == 'pending' || data.status == 'accepted' || data.status == 'preparing' || data.status == 'ready' || data.status == 'transit' || data.status == 'delivered' || data.status == 'completed' || data.status == 'cancelled')
        && (data.price is int || data.price is float)
        && (!data.keys().hasAny(['pickupAddress']) || (data.pickupAddress is string && data.pickupAddress.size() <= 300))
        && (!data.keys().hasAny(['dropAddress']) || (data.dropAddress is string && data.dropAddress.size() <= 300))
        && (!data.keys().hasAny(['driverId']) || data.driverId == null || (data.driverId is string && data.driverId.size() <= 100))
        && (!data.keys().hasAny(['driverName']) || (data.driverName is string && data.driverName.size() <= 100))
        && (!data.keys().hasAny(['otp']) || (data.otp is string && data.otp.size() <= 10))
        && (!data.keys().hasAny(['paymentStatus']) || data.paymentStatus == 'paid' || data.paymentStatus == 'refund_processing' || data.paymentStatus == 'refunded' || data.paymentStatus == 'refund_required')
        && (!data.keys().hasAny(['paymentMethod']) || data.paymentMethod == 'upi' || data.paymentMethod == 'card' || data.paymentMethod == 'netbanking' || data.paymentMethod == 'wallet' || data.paymentMethod == 'emi' || data.paymentMethod == 'other')
        && (!data.keys().hasAny(['paymentOrderId']) || (data.paymentOrderId is string && data.paymentOrderId.size() <= 100))
        && (!data.keys().hasAny(['paymentId']) || (data.paymentId is string && data.paymentId.size() <= 100));
    }

    function isValidSupportTicket(data) {
      return data.keys().hasAll(['ticketId', 'userId', 'subject', 'message', 'status'])
        && data.keys().hasOnly(['ticketId', 'userId', 'subject', 'message', 'status', 'createdAt'])
        && data.ticketId is string && data.ticketId.size() <= 100
        && data.userId == request.auth.uid
        && data.subject is string && data.subject.size() <= 200
        && data.message is string && data.message.size() <= 2000
        && (data.status == 'open' || data.status == 'resolved');
    }

    // 4. RESOURCE SPECIFIC SECURITY BOUNDARIES

    // USERS COLLECTION
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) && incoming().role == 'customer' && incoming().get('walletBalance', 0) == 0 && !incoming().keys().hasAny(['merchantId', 'merchantType', 'accountAuthority', 'neonAccountId']);
      allow update: if isSignedIn() && ((isOwner(userId) && isValidUser(incoming()) && incoming().get('accountAuthority', null) == existing().get('accountAuthority', null) && incoming().get('neonAccountId', null) == existing().get('neonAccountId', null) && incoming().role == existing().role && incoming().walletBalance == existing().walletBalance && incoming().get('merchantId', null) == existing().get('merchantId', null) && incoming().get('merchantType', null) == existing().get('merchantType', null)));
      // Account deletion must use the cross-store server workflow so linked
      // identity, sessions, bookings and audit data are cleaned consistently.
      allow delete: if false;

      match /addresses/{addressId} {
        function validAddress(data) {
          return data.keys().hasAll(['label', 'address', 'createdAt'])
            && data.keys().hasOnly(['label', 'address', 'createdAt', 'deliveryDetails'])
            && (!('deliveryDetails' in data) || (data.deliveryDetails is map
              && data.deliveryDetails.keys().hasAll(['building', 'landmark', 'instructions'])
              && data.deliveryDetails.keys().hasOnly(['building', 'landmark', 'instructions'])
              && data.deliveryDetails.building is string && data.deliveryDetails.building.size() <= 80
              && data.deliveryDetails.landmark is string && data.deliveryDetails.landmark.size() <= 80
              && data.deliveryDetails.instructions is string && data.deliveryDetails.instructions.size() <= 120))
            && data.label is string && data.label.size() > 0 && data.label.size() <= 30
            && data.address is string && data.address.size() > 0 && data.address.size() <= 300
            && data.createdAt is string && data.createdAt.size() <= 40;
        }
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && validAddress(incoming());
        allow update: if isOwner(userId) && validAddress(incoming())
          && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }
    }

    // DRIVER PROFILES
    match /pricing_changes/{changeId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /driver_profiles/{driverId} {
      allow get: if isOwner(driverId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && isDriverOwner(driverId)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver'
        && isValidDriverProfile(incoming(), driverId)
        && incoming().status == 'pending' && incoming().online == false
        && incoming().todayEarnings == 0 && incoming().completedJobs == 0
        && incoming().get('availableEarningsCents', 0) == 0 && incoming().get('reservedEarningsCents', 0) == 0
        && incoming().get('rejectedBookingIds', []) == [] && incoming().get('supportedServices', []) == []
        && !incoming().keys().hasAny(['transportCapabilities', 'locationConsent', 'locationConsentAt'])
        && !('activeBookingId' in incoming());
      allow update: if isSignedIn() && (
        (isDriverOwner(driverId) && isValidDriverProfile(incoming(), driverId) && (
          // Drivers can update online state or coordinates, but can't self-approve verification status
          incoming().get('currentLat', null) == existing().get('currentLat', null) &&
          incoming().get('currentLng', null) == existing().get('currentLng', null) &&
          incoming().get('locationUpdatedAt', null) == existing().get('locationUpdatedAt', null) &&
          incoming().get('locationAccuracyMeters', null) == existing().get('locationAccuracyMeters', null) &&
          incoming().status == existing().status &&
          incoming().todayEarnings == existing().todayEarnings &&
          incoming().completedJobs == existing().completedJobs &&
          incoming().get('activeBookingId', null) == existing().get('activeBookingId', null) &&
          incoming().get('rejectedBookingIds', []) == existing().get('rejectedBookingIds', []) &&
          incoming().get('availableEarningsCents', 0) == existing().get('availableEarningsCents', 0) &&
          incoming().get('reservedEarningsCents', 0) == existing().get('reservedEarningsCents', 0) &&
          incoming().get('supportedServices', []) == existing().get('supportedServices', []) &&
          incoming().get('transportCapabilities', null) == existing().get('transportCapabilities', null) &&
          incoming().get('locationConsent', false) == existing().get('locationConsent', false) &&
          incoming().get('locationConsentAt', null) == existing().get('locationConsentAt', null) &&
          (!incoming().online || incoming().get('locationConsent', false) == true) &&
          (!incoming().online || existing().get('activeBookingId', null) != null || driverEligibilityNotExpired(driverId)) &&
          (existing().status != 'verified' || (incoming().vehicleType == existing().vehicleType && incoming().vehicleNo == existing().vehicleNo && incoming().licenseNo == existing().licenseNo)) &&
          incoming().get('earningsDate', null) == existing().get('earningsDate', null)
        ))
      );
      allow delete: if false;
    }

    match /driver_eligibility/{driverId} {
      allow read: if isAdmin();
      allow write: if false;
      match /events/{eventId} { allow read: if isAdmin(); allow write: if false; }
    }

    // RESTAURANTS & SUB-COLLECTIONS
    match /operations_audit/{entryId} { allow read: if isAdmin(); allow write: if false; }
    match /partner_applications/{applicationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
      match /events/{eventId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/partner_applications/$(applicationId)).data.userId == request.auth.uid || isAdmin());
        allow write: if false;
      }
    }
    match /partner_evidence/{evidenceId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /evidence_audit/{entryId} { allow read: if isAdmin(); allow write: if false; }
    match /service_zones/{zoneId} { allow read: if isAdmin(); allow write: if false; }
    match /service_pricing/{serviceId} { allow read: if isAdmin(); allow write: if false; }
    match /service_pricing/{serviceId}/versions/{version} { allow read: if isAdmin(); allow write: if false; }
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if false;

      match /menu_items/{itemId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // GROCERY STORES & SUB-COLLECTIONS
    match /grocery_stores/{storeId} {
      allow read: if true;
      allow write: if false;

      match /products/{productId} {
        allow read: if true;
        allow write: if false;
        match /stock_events/{eventId} {
          allow read: if isSignedIn() && (isAdmin() || isMerchantFor({'merchantId': storeId, 'serviceType': 'grocery'}));
          allow write: if false;
        }
      }
    }

    // BOOKINGS (Unified transactional records)
    match /bookings/{bookingId} {
      allow get: if canAccessBooking(bookingId);
      // SEC-04: Drivers must NOT be able to list raw unassigned bookings — full customer PII
      // (name, address, notes) would be readable before assignment. Dispatch is server-side only.
      allow list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        isAssignedVerifiedDriver(resource.data) ||
        isMerchantFor(resource.data) ||
        isAdmin()
      );
      // Customer bookings are created by the verified payment Cloud Function only.
      allow create: if false;
      // Driver transitions and settlement use transactional Cloud Functions.
      allow update, delete: if false;

      match /events/{eventId} { allow read: if canAccessBooking(bookingId); allow write: if false; }

      match /chats/{chatId} {
        function canChat() {
          let booking = get(/databases/$(database)/documents/bookings/$(bookingId)).data;
          return isSignedIn() && (booking.customerId == request.auth.uid || isAssignedVerifiedDriver(booking) || isAdmin());
        }
        allow read: if canChat();
        allow create: if false;
        allow update, delete: if false;
      }
    }

    match /booking_tracking/{bookingId} {
      allow get: if canAccessDeliveryDetails(bookingId);
      allow list, write: if false;
    }

    match /booking_contacts/{bookingId} {
      // Sender/recipient phones are private, including while a job is offered to partners.
      allow get: if canAccessDeliveryDetails(bookingId);
      allow list, write: if false;
    }

    match /wallet_ledger/{userId}/entries/{entryId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }
    match /account_deletions/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    match /booking_codes/{bookingId} {
      allow get, list: if isSignedIn() && resource.data.customerId == request.auth.uid;
      allow write: if false;
    }

    // TRIP BUNDLES & LEGS
    match /bundles/{bundleId} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow write: if false; // server-only

      match /legs/{legId} {
        // customer sees all their legs; driver sees only their own leg; merchant sees only their assigned leg
        allow read: if canReadLeg(bundleId, resource.data);
        allow write: if false; // server-only

        match /events/{eventId} {
          allow read: if canReadLeg(bundleId, get(/databases/$(database)/documents/bundles/$(bundleId)/legs/$(legId)).data);
          allow write: if false;
        }

        match /chats/{chatId} {
          allow read: if canReadBundleChat(bundleId, get(/databases/$(database)/documents/bundles/$(bundleId)/legs/$(legId)).data);
          allow create: if false; // authorized, rate-limited server command only
          allow update, delete: if false;
        }
      }
    }

    match /bundle_tracking/{bundleId} {
      allow read: if isSignedIn() && (
        get(/databases/$(database)/documents/bundles/$(bundleId)).data.customerId == request.auth.uid
        || isAdmin()
      );
      allow write: if false;
    }

    match /bundle_codes/{bundleId} {
      allow read: if isSignedIn() && (
        get(/databases/$(database)/documents/bundles/$(bundleId)).data.customerId == request.auth.uid
        || isAdmin()
      );
      allow write: if false;
    }

    match /subscriptions/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin(); // only admins can grant/revoke
    }

    // Payment attempts are private to trusted Cloud Functions (Admin SDK bypasses these rules).
    match /payment_attempts/{attemptId} {
      allow read, write: if false;
    }
    match /order_reviews/{reviewId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // SUPPORT TICKETS
    match /support_tickets/{ticketId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
      match /{subcollection}/{entryId} {
        allow get, list: if subcollection in ['messages', 'events'] && isSignedIn()
          && (get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid || isAdmin());
        allow write: if false;
      }
    }

    match /payout_requests/{requestId} {
      allow create: if false;
      allow get, list: if isSignedIn() && (resource.data.driverId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    match /driver_ledger/{driverId}/entries/{entryId} {
      allow read: if isOwner(driverId) || isAdmin();
      allow write: if false;
    }
    match /financial_journals/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
