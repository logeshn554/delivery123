# Separate AllGo staging project and separate Neon staging database.
# Copy to .env.staging.local (ignored). Fill with actual staging configuration.
# Display name: AllGo Staging. Project ID is assigned/confirmed in Firebase Console.
NODE_ENV=production
ALLGO_ENVIRONMENT=staging
ACCOUNT_API_HOST=0.0.0.0
VITE_DEMO_MODE=false
DATABASE_URL=
ACCOUNT_API_PORT=3004
ACCOUNT_ALLOWED_ORIGINS=
ACCOUNT_FIREBASE_BRIDGE_ENABLED=true
ACCOUNT_EMAIL_API_KEY=
ACCOUNT_EMAIL_FROM=
ACCOUNT_PUBLIC_WEB_ORIGIN=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
VITE_AUTH_PROVIDER=neon
VITE_ACCOUNT_API_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_ID=(default)
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
EVIDENCE_STORAGE_BUCKET=
EVIDENCE_SCANNER_HOST=
EVIDENCE_SCANNER_PORT=
# Scanner mutual-TLS CA/client certificate/key belong in project Secret Manager.
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_APP_CHECK_ENABLED=true
VITE_APP_CHECK_DEBUG=false
VITE_APP_CHECK_SITE_KEY=
REQUIRE_APP_CHECK=true
VITE_BUSINESS_NAME=AllGo
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
VITE_PRIVACY_URL=
VITE_TERMS_URL=
VITE_CANCELLATION_URL=
# Payment/Maps secrets belong in the staging Firebase Secret Manager.
# App Check flags above describe the target release setup: validate real attestation first.
