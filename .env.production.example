# Copy to .env.production.local and supply owner-controlled production resources.
NODE_ENV=production
ALLGO_ENVIRONMENT=production
DATABASE_URL=
ACCOUNT_API_HOST=0.0.0.0
ACCOUNT_API_PORT=3004
# Reverse-proxy hops in front of the account API (0 = clients connect directly). Required: authentication
# rate limits key on the client address, so a wrong value either merges all users into one bucket or lets
# clients forge their address. Every ingress path must traverse that many trusted proxies;
# prevent direct access and ensure the edge appends/replaces forwarded headers.
ACCOUNT_TRUST_PROXY=
ACCOUNT_ALLOWED_ORIGINS=
ACCOUNT_FIREBASE_BRIDGE_ENABLED=true
ACCOUNT_EMAIL_API_KEY=
ACCOUNT_EMAIL_FROM=
ACCOUNT_PUBLIC_WEB_ORIGIN=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
VITE_AUTH_PROVIDER=neon
VITE_ACCOUNT_API_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_ID=(default)
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
EVIDENCE_STORAGE_BUCKET=
EVIDENCE_SCANNER_HOST=
EVIDENCE_SCANNER_PORT=
# Scanner mutual-TLS CA/client certificate/key belong in project Secret Manager.
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_APP_CHECK_ENABLED=true
VITE_APP_CHECK_DEBUG=false
VITE_APP_CHECK_SITE_KEY=
VITE_DEMO_MODE=false
REQUIRE_APP_CHECK=true
VITE_BUSINESS_NAME=
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
VITE_PRIVACY_URL=
VITE_TERMS_URL=
VITE_CANCELLATION_URL=
